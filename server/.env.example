# Server configuration
PORT=5000
NODE_ENV=development

# Required for real database usage in development and production
# Use MongoDB Atlas or a local MongoDB instance, not the in-memory fallback for production.
MONGODB_URI=mongodb://127.0.0.1:27017/blog-platform

# Use a long, random value. Never use this placeholder in a running environment.
JWT_SECRET=replace_with_a_long_random_secret

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
